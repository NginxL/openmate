{
  "market_version": 1,
  "name": "OpenMate",
  "description": "OpenMate：把飞书等聊天软件接进 Persona 的开源扩展（MIT）。",
  "homepage": "https://github.com/NginxL/openmate",
  "extensions": [
    {
      "manifest": {
        "manifest_version": 1,
        "id": "openmate-feishu",
        "name": "飞书（OpenMate）",
        "version": "0.6.2",
        "description": "把飞书私聊和群消息接进 Persona 的收件箱和知识库，手机确认后以你的身份发消息，支持 /agent。通过你自己安装的 LarkAgentX（非官方网页协议）连接，与飞书官方无关。",
        "publisher": "NginxL",
        "homepage": "https://github.com/NginxL/openmate",
        "engines": {
          "persona": ">=202611110000",
          "extension_protocol": 1
        },
        "runtime": {
          "command": "bin/openmate-feishu"
        },
        "activation_events": [
          "on_startup"
        ],
        "contributes": {
          "connectors": [
            {
              "id": "matefeishu",
              "name": "飞书（OpenMate）",
              "capabilities": [
                "status",
                "tools",
                "actions",
                "events",
                "inbox",
                "archive",
                "login",
                "threads"
              ],
              "agent_tools": [
                "matefeishu_status",
                "matefeishu_chats",
                "matefeishu_messages",
                "matefeishu_search",
                "matefeishu_docs",
                "matefeishu_agent_reply"
              ],
              "confirm_always": [
                "matefeishu_*"
              ],
              "sends_as_user": true,
              "poll_seconds": 60,
              "kinds": [
                "dm",
                "mention",
                "group"
              ],
              "kind_descriptions": {
                "dm": "类型：飞书私聊里别人发给我、我还没回的消息",
                "mention": "类型：飞书群里有人 @我、我还没回的消息",
                "group": "类型：飞书群里的新消息，没有 @我"
              }
            }
          ],
          "assistant": [
            {
              "id": "matefeishu",
              "instructions": "assistant/instructions.md"
            }
          ],
          "ui": [
            {
              "id": "today",
              "title": "今天",
              "placement": "nav_page",
              "icon": "bell"
            },
            {
              "id": "today-card",
              "title": "今天",
              "placement": "overview_card",
              "opens": "today"
            },
            {
              "id": "chats",
              "title": "飞书",
              "placement": "nav_page",
              "icon": "list"
            },
            {
              "id": "chats-today",
              "title": "飞书今天",
              "placement": "overview_card",
              "opens": "chats"
            },
            {
              "id": "calendar",
              "title": "日程",
              "placement": "nav_page",
              "icon": "calendar"
            },
            {
              "id": "calendar-today",
              "title": "今天的日程",
              "placement": "overview_card",
              "opens": "calendar"
            },
            {
              "id": "starkmesh",
              "title": "中转站",
              "placement": "nav_page",
              "icon": "wallet"
            }
          ]
        },
        "configuration": {
          "type": "object",
          "properties": {
            "larkx_python": {
              "type": "string",
              "title": "LarkAgentX 的 Python",
              "description": "装了 LarkAgentX 的 Python 解释器的绝对路径（例如某个 venv 里的 bin/python）。LarkAgentX 需要你自己安装，本扩展不附带。",
              "maxLength": 1024
            },
            "larkx_commit": {
              "type": "string",
              "title": "LarkAgentX 版本",
              "description": "这个扩展适配的 LarkAgentX 提交（40 位十六进制）。只有确认换了 LarkAgentX 版本时才改。",
              "default": "97ad48e69e34bd8c78ee30f795b7c3759dd81659",
              "pattern": "^[0-9a-f]{40}$"
            },
            "region": {
              "type": "string",
              "title": "区域",
              "description": "飞书（中国）或 Lark（国际版）",
              "default": "feishu",
              "oneOf": [
                {
                  "const": "feishu",
                  "title": "飞书"
                },
                {
                  "const": "lark",
                  "title": "Lark（国际版）"
                }
              ]
            },
            "http_proxy": {
              "type": "string",
              "title": "代理",
              "description": "连接飞书时用的代理，只支持 http:// 或 https://，例如 http://127.0.0.1:7890，只对这个扩展生效。留空就用系统设置；系统代理是 SOCKS 时，LarkAgentX 的 Python 里要装 python-socks。",
              "maxLength": 512
            },
            "agent": {
              "type": "boolean",
              "title": "启用 /agent",
              "description": "你在飞书里发以前缀开头的消息时，交给 Agent 处理，并以你的身份回复。",
              "default": false,
              "x-confirm": "打开后，你自己在飞书里发的 /agent 消息会让 Agent 用你的全部权限处理，并以你的身份回复到原话题。确定打开吗？"
            },
            "agent_prefix": {
              "type": "string",
              "title": "/agent 前缀",
              "description": "以“/”开头、不含空格，不能是 /stop。",
              "default": "/agent",
              "pattern": "^/\\S+$",
              "maxLength": 32
            },
            "agent_machine": {
              "type": "string",
              "format": "machine",
              "title": "/agent 在哪台电脑上跑",
              "description": "不设置就用助手所在的电脑。"
            },
            "agent_launcher": {
              "type": "string",
              "format": "launcher",
              "title": "/agent 用哪个启动器",
              "description": "不设置就用 Persona 里“Lark /agent”的模型设置。"
            },
            "agent_reply_header": {
              "type": "string",
              "title": "AI 回复抬头",
              "description": "每条 /agent 回复的第一行，{model} 和 {effort} 换成回答它的模型和思考强度。留空表示不加。",
              "default": "> 🤖 AI 回复 · {model} · {effort}",
              "maxLength": 200
            },
            "agent_ack_reaction": {
              "type": "string",
              "title": "接单表情",
              "description": "收到 /agent 请求时在那条消息上点的表情（飞书表情代号，如 THINKING、OnIt、OK）。留空表示不点。",
              "default": "THINKING",
              "maxLength": 40
            },
            "auto_reply": {
              "type": "boolean",
              "title": "自动代答",
              "description": "在“飞书”页里开了自动代答的群，有人 @ 你时 AI 直接以你的身份回复，不用确认（要先打开 /agent）。私聊、机器人和 @所有人 不代答。",
              "default": true
            },
            "auto_reply_docs": {
              "type": "boolean",
              "title": "文档评论代答",
              "description": "有人在飞书文档或知识库的评论里 @ 你时，AI 直接以你的身份在那条评论下回复，不用确认（要先打开 /agent；用 lark-cli 发回复）。",
              "default": true
            },
            "auto_reply_daily_most": {
              "type": "integer",
              "title": "每个群每天最多代答",
              "description": "超过后当天不再代答，留给你自己回复。",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            },
            "auto_reply_header": {
              "type": "string",
              "title": "代答抬头",
              "description": "自动代答回复的第一行，{model} 和 {effort} 换成回答它的模型和思考强度。留空表示不加。",
              "default": "> 🤖 AI 代答 · {model} · {effort}",
              "maxLength": 200
            },
            "agent_reply_suffix": {
              "type": "string",
              "title": "AI 代答标记",
              "description": "加在每条 /agent 回复末尾，例如“> 🤖 AI 代答，仅供参考”。写 \\n 表示换行；留空表示不加。",
              "default": "",
              "maxLength": 200
            },
            "history_chats": {
              "type": "integer",
              "title": "首次补收的会话数",
              "description": "第一次登录后，补收最近多少个会话的历史消息（0–50）。",
              "default": 20,
              "minimum": 0,
              "maximum": 50
            },
            "triage_rules": {
              "type": "string",
              "title": "收件箱分拣规则",
              "description": "用你自己的话写飞书消息该怎么分拣（哪些要你处理、哪些看看就行、哪些是噪音）。留空就用 Persona 的全局规则。没有 @你 的群消息总是按噪音处理。",
              "maxLength": 4000
            },
            "lark_cli": {
              "type": "string",
              "title": "lark-cli 路径",
              "description": "日程页用飞书 lark-cli 只读地读你的日历（calendar +agenda）。留空时在 PATH 和登录 shell 里找 lark-cli。"
            },
            "lark_cli_profile": {
              "type": "string",
              "title": "lark-cli 配置档",
              "description": "lark-cli 的 --profile：你为 Persona 登录的那个飞书应用。留空用 lark-cli 的默认配置档。需要日历只读权限（calendar:calendar.event:read）。"
            },
            "starkmesh_url": {
              "type": "string",
              "format": "uri",
              "title": "StarkMesh 地址",
              "description": "StarkMesh 网关的地址（这台电脑上能访问到的，例如 http://127.0.0.1:18080）。StarkMesh 页和“今天”页的额度卡片从这里只读地读账号和用量。地址和下面的密钥都填了才会显示。"
            }
          }
        },
        "secrets": [
          {
            "name": "starkmesh_key",
            "title": "StarkMesh 只读管理密钥",
            "hint": "last4",
            "description": "在 StarkMesh 后台 设置 › 管理密钥 新建，只勾读取权限：accounts.read、accounts.usage.read、accounts.stats.read、dashboard.read。不填就不显示 StarkMesh。"
          }
        ],
        "permissions": {
          "network": [
            "feishu.cn",
            "*.feishu.cn",
            "larksuite.com",
            "*.larksuite.com",
            "larkoffice.com",
            "*.larkoffice.com",
            "config:starkmesh_url:http"
          ],
          "hub": [
            "agents.control",
            "agents.read",
            "assistant.ask",
            "inbox.read",
            "kb.read",
            "todos.read"
          ]
        },
        "host_integrations": [
          {
            "id": "lark-cli",
            "version": ">=1.0.72 <2.0.0"
          }
        ]
      },
      "tags": [
        "飞书",
        "Lark",
        "聊天",
        "收件箱",
        "知识库",
        "OpenMate"
      ],
      "icon": "assets/icon.png",
      "packages": [
        {
          "url": "packages/openmate-feishu/0.6.2/openmate-feishu-0.6.2.tar.gz",
          "sha256": "beaa342ae697588fa37e42661d3783f636b0ad564d23f906000e9be7c7143d36",
          "size": 127815
        }
      ]
    }
  ]
}
